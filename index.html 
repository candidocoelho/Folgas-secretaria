// ─── CALENDÁRIO ──────────────────────────────────────────────────
function Calendario({data}) {
  const hoje = new Date();
  const [mes, setMes] = useState(hoje.getMonth());
  const [ano, setAno] = useState(hoje.getFullYear());

  const MESES=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  const DIAS_SEM=['D','S','T','Q','Q','S','S'];

  function navMes(dir){
    let nm=mes+dir, na=ano;
    if(nm<0){nm=11;na--;} if(nm>11){nm=0;na++;}
    setMes(nm);setAno(na);
  }

  const folgasAprovadas=data.solicitacoes.filter(s=>s.status==='aprovado');

  function getFolgasNoDia(dia){
    const dateStr=`${ano}-${String(mes+1).padStart(2,'0')}-${String(dia).padStart(2,'0')}`;
    return folgasAprovadas.filter(f=>f.dataInicio<=dateStr && f.dataFim>=dateStr);
  }

  const primeiroDia=new Date(ano,mes,1).getDay();
  const totalDias=new Date(ano,mes+1,0).getDate();
  const cells=[];
  for(let i=0;i<primeiroDia;i++) cells.push(null);
  for(let d=1;d<=totalDias;d++) cells.push(d);

  return (
    <div>
      <div style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:16}}>
        <button style={{...S.btnSec,padding:'6px 14px'}} onClick={()=>navMes(-1)}>‹</button>
        <span style={{fontWeight:700,fontSize:15,color:'#1E293B'}}>{MESES[mes]} {ano}</span>
        <button style={{...S.btnSec,padding:'6px 14px'}} onClick={()=>navMes(1)}>›</button>
      </div>
      <div style={{display:'grid',gridTemplateColumns:'repeat(7,1fr)',gap:2,marginBottom:8}}>
        {DIAS_SEM.map((d,i)=>(
          <div key={i} style={{textAlign:'center',fontSize:11,fontWeight:700,color:'#94A3B8',padding:'4px 0'}}>{d}</div>
        ))}
        {cells.map((dia,i)=>{
          if(!dia) return <div key={i}/>;
          const folgas=getFolgasNoDia(dia);
          const temFolga=folgas.length>0;
          const isHoje=dia===hoje.getDate()&&mes===hoje.getMonth()&&ano===hoje.getFullYear();
          return (
            <div key={i} style={{
              textAlign:'center',padding:'6px 2px',borderRadius:8,
              background:temFolga?'#ECFDF5':isHoje?'#EEF2FF':'transparent',
              border:isHoje?'2px solid #6366F1':temFolga?'1px solid #A7F3D0':'1px solid transparent',
              cursor:temFolga?'pointer':'default',
            }} title={temFolga?folgas.map(f=>f.servidorNome).join(', '):''}>
              <div style={{fontSize:13,fontWeight:isHoje?700:400,color:temFolga?'#059669':isHoje?'#6366F1':'#1E293B'}}>{dia}</div>
              {temFolga&&(
                <div style={{fontSize:9,color:'#059669',marginTop:1,lineHeight:1.2}}>
                  {folgas.length===1?folgas[0].servidorNome.split(' ')[0]:`${folgas.length} serv.`}
                </div>
              )}
            </div>
          );
        })}
      </div>
      <div style={{marginTop:12,display:'flex',gap:12,flexWrap:'wrap'}}>
        <div style={{display:'flex',alignItems:'center',gap:6}}>
          <div style={{width:12,height:12,borderRadius:3,background:'#ECFDF5',border:'1px solid #A7F3D0'}}/>
          <span style={{fontSize:11,color:'#64748B'}}>Folga aprovada</span>
        </div>
        <div style={{display:'flex',alignItems:'center',gap:6}}>
          <div style={{width:12,height:12,borderRadius:3,background:'#EEF2FF',border:'2px solid #6366F1'}}/>
          <span style={{fontSize:11,color:'#64748B'}}>Hoje</span>
        </div>
      </div>
      <h3 style={{...S.secTitle,marginTop:20}}>Folgas aprovadas neste mês</h3>
      {(()=>{
        const ini=`${ano}-${String(mes+1).padStart(2,'0')}-01`;
        const fim=`${ano}-${String(mes+1).padStart(2,'0')}-${String(totalDias).padStart(2,'0')}`;
        const doMes=folgasAprovadas.filter(f=>periodosSobrepoem(f.dataInicio,f.dataFim,ini,fim));
        if(!doMes.length) return <p style={S.empty}>Nenhuma folga aprovada neste mês.</p>;
        return (
          <div style={S.list}>
            {doMes.map(f=>(
              <div key={f.id} style={{...S.item,borderColor:'#A7F3D0',background:'#F0FDF4'}}>
                <div>
                  <div style={S.iTitle}>{f.servidorNome}</div>
                  <div style={S.iSub}>{fmtDate(f.dataInicio)} → {fmtDate(f.dataFim)}</div>
                </div>
                <span style={{fontSize:12,fontWeight:700,color:'#059669'}}>
                  {Math.round((new Date(f.dataFim)-new Date(f.dataInicio))/86400000)+1}d
                </span>
              </div>
            ))}
          </div>
        );
      })()}
    </div>
  );
}

