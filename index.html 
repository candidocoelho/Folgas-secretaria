async function fetchAllData() {
  const [sv,sa,re,so,cfg] = await Promise.all([
    sb.from('servidores').select('*').order('matricula'),
    sb.from('saldos').select('*').order('criado_em'),
    sb.from('remocoes').select('*').order('criado_em'),
    sb.from('solicitacoes').select('*').order('criado_em',{ascending:false}),
    sb.from('config').select('*').limit(1).single(),
  ]);
  return {
    adminSenha: cfg.data?.admin_senha || 'admin123',
    servidores: (sv.data||[]).map(x=>({id:x.id,matricula:x.matricula,nome:x.nome,cargo:x.cargo,senha:x.senha})),
    saldos: (sa.data||[]).map(x=>({id:x.id,servidorId:x.servidor_id,dias:Number(x.dias),obs:x.obs,criadoEm:x.criado_em})),
    remocoes: (re.data||[]).map(x=>({id:x.id,servidorId:x.servidor_id,dias:Number(x.dias),motivo:x.motivo,criadoEm:x.criado_em})),
    solicitacoes: (so.data||[]).map(x=>({id:x.id,servidorId:x.servidor_id,servidorNome:x.servidor_nome,dataInicio:x.data_inicio,dataFim:x.data_fim,motivo:x.motivo,status:x.status,criadoEm:x.criado_em})),
  };
}

function calcSaldo(data,sid) {
  const gerado   = data.saldos.filter(s=>s.servidorId===sid).reduce((a,s)=>a+s.dias,0);
  const removido = data.remocoes.filter(r=>r.servidorId===sid).reduce((a,r)=>a+r.dias,0);
  const usado    = data.solicitacoes.filter(s=>s.servidorId===sid&&s.status==='aprovado').reduce((a,s)=>a+Math.round((new Date(s.dataFim)-new Date(s.dataInicio))/86400000)+1,0);
  return {gerado,removido,usado,saldo:gerado-removido-usado};
}

function fmtDate(str) {
  if(!str) return '';
  const [y,m,d]=str.split('-');
  return `${d}/${m}/${y}`;
}
function fmtDT(iso) {
  if(!iso) return '';
  return new Date(iso).toLocaleDateString('pt-BR');
}
function periodosSobrepoem(ini1,fim1,ini2,fim2) {
  return ini1<=fim2 && ini2<=fim1;
}

