function SenhaForm({senhaAtual,onSave}) {
  const refAtual=useRef(null);
  const refNova=useRef(null);
  const refConfirma=useRef(null);
  const [erro,setErro]=useState('');
  const [ok,setOk]=useState(false);
  const [busy,setBusy]=useState(false);
  const [resetKey,setResetKey]=useState(0);
  async function salvar() {
    const atual=refAtual.current?.value||'';
    const nova=refNova.current?.value||'';
    const confirma=refConfirma.current?.value||'';
    setErro('');setOk(false);
    if(atual!==senhaAtual){setErro('Senha atual incorreta.');return;}
    if(nova.length<3){setErro('Mínimo 3 caracteres.');return;}
    if(nova!==confirma){setErro('Senhas não coincidem.');return;}
    setBusy(true);
    try{await onSave(nova);setResetKey(k=>k+1);setOk(true);}
    catch{setErro('Erro ao salvar.');}
    finally{setBusy(false);}
  }
  return (
    <div style={S.senhaBox} key={resetKey}>
      <h3 style={{...S.secTitle,marginBottom:12}}>🔑 Alterar Senha</h3>
      <label style={S.label}>Senha atual</label>
      <input ref={refAtual} style={S.input} type="password" autoCapitalize="none" autoCorrect="off" autoComplete="new-password" spellCheck="false" onChange={()=>{setErro('');setOk(false);}}/>
      <label style={{...S.label,marginTop:8}}>Nova senha</label>
      <input ref={refNova} style={S.input} type="password" autoCapitalize="none" autoCorrect="off" autoComplete="new-password" spellCheck="false" onChange={()=>{setErro('');setOk(false);}}/>
      <label style={{...S.label,marginTop:8}}>Confirmar</label>
      <input ref={refConfirma} style={S.input} type="password" autoCapitalize="none" autoCorrect="off" autoComplete="new-password" spellCheck="false" onChange={()=>{setErro('');setOk(false);}}/>
      {erro&&<p style={{color:'#DC2626',fontSize:13,margin:'4px 0 0'}}>⚠ {erro}</p>}
      {ok&&<p style={{color:'#059669',fontSize:13,margin:'4px 0 0'}}>✓ Senha alterada!</p>}
      <button style={{...S.btnPrimary,marginTop:10,opacity:busy?0.6:1}} onClick={salvar} disabled={busy}>
        {busy?'Salvando...':'Salvar nova senha'}
      </button>
    </div>
  );
}

